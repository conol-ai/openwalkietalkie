[Unit]
Description=OpenWalkieTalkie Omarchy bridge (Hyprland and coding-agent sessions on the deck)
After=deckd.service
Wants=deckd.service

[Service]
ExecStart=/usr/bin/python3 -u %h/.local/share/openwalkietalkie/omarchy/omarchy_deck.py --socket %h/.local/share/openwalkietalkie/deckd.sock
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
