<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "https://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Embedded into the `deckd` executable itself (__TEXT,__info_plist, by
  embed_plist in src/main.rs) for the bare dev binary tools/install-host.sh
  starts from launchd with no bundle around it: macOS reads a process's
  usage strings from its Info.plist, finds this one in the binary, and
  terminates a process that touches CoreBluetooth (or the microphone)
  without them rather than asking.

  CFBundleIdentifier is the identifier tools/package-macos.sh signs both
  bundled Mach-Os with (`codesign -i ai.cohdl.openwalkietalkie`), so the
  bundled deckd, which carries this section too, signs as exactly what it
  signed as before; inside the bundle the app's own Contents/Info.plist
  (packaging/macos/Info.plist.in) is the one macOS shows. The usage strings
  are that file's, word for word; tests/info_plist.rs keeps them so.
-->
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>ai.cohdl.openwalkietalkie</string>
    <key>CFBundleName</key>
    <string>deckd</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>OpenWalkieTalkie talks to your deck over Bluetooth: it hears the deck's microphone while you hold the talk key, and plays replies and chimes on the deck's speaker.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>OpenWalkieTalkie listens only while you hold the deck's talk key, so what you say can be sent to the agent you picked.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>OpenWalkieTalkie turns what you said into text on this Mac, so the agent receives a message instead of a recording.</string>
</dict>
</plist>
