<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "https://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template for OpenWalkieTalkie.app/Contents/Info.plist (docs/host-service.md
  §10.1). tools/package-macos.sh substitutes every placeholder below and then
  runs `plutil -lint` over the result; one left unsubstituted fails the run,
  which is why no placeholder-shaped text appears in this comment.

  Both Mach-Os in the bundle sign as CFBundleIdentifier below, so the usage
  strings here are the ones macOS shows for the daemon's prompts too —
  `deckd` takes its identity from the enclosing app (§10.1). The bare dev
  binary has its own copy embedded (host/crates/deckd/Info.plist).
-->
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleDisplayName</key>
    <string>OpenWalkieTalkie</string>
    <key>CFBundleExecutable</key>
    <string>OpenWalkieTalkie</string>
    <key>CFBundleIdentifier</key>
    <string>ai.cohdl.openwalkietalkie</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>OpenWalkieTalkie</string>
    <key>CFBundleIconFile</key>
    <string>OpenWalkieTalkie.icns</string>
    <key>NSHumanReadableCopyright</key>
    <string>A COHDL project · Open-source software under the MIT license.</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>@APP_VERSION@</string>
    <key>CFBundleVersion</key>
    <string>@APP_VERSION@</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.developer-tools</string>
    <!-- SMAppService, which is how the GUI registers the bundled LaunchAgent
         (§10.2), is macOS 13 and later. -->
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <!-- Ships as a regular Dock app; the GUI toggles agent/accessory at
         runtime the way openmicrokbd does (§10.1). -->
    <key>LSUIElement</key>
    <false/>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSSupportsAutomaticGraphicsSwitching</key>
    <true/>
    <!-- The usage strings §10.1 names. SFSpeechRecognizer *crashes* without
         its own string rather than being denied, so none of these is
         optional. -->
    <key>NSMicrophoneUsageDescription</key>
    <string>OpenWalkieTalkie listens only while you hold the deck's talk key, so what you say can be sent to the agent you picked.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>OpenWalkieTalkie turns what you said into text on this Mac, so the agent receives a message instead of a recording.</string>
    <!-- No Apple Events usage string: nothing in the bundle sends Apple
         events since the Ghostty path was retired (the hand-off opens the
         session's app with `open -b`), so there is no Automation prompt to
         word. -->
    <!-- deckd reaches the deck's microphone and speaker through its own BLE
         audio service with CoreBluetooth (`[voice] transport = "ble"`, the
         default). macOS terminates a process that touches CoreBluetooth
         without this string rather than denying it. -->
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>OpenWalkieTalkie talks to your deck over Bluetooth: it hears the deck's microphone while you hold the talk key, and plays replies and chimes on the deck's speaker.</string>
    <!-- Sparkle (§10.3): a check at launch and every 6 h, Ed25519 only, and
         the update is verified before it is unpacked. -->
    <key>OpenWalkieTalkieAutomaticUpdates</key>
    @SPARKLE_ENABLED@
    <key>SUAutomaticallyUpdate</key>
    @SPARKLE_ENABLED@
    <key>SUFeedURL</key>
    <string>@SPARKLE_FEED_URL@</string>
    <key>SUPublicEDKey</key>
    <string>@SPARKLE_PUBLIC_ED_KEY@</string>
    <key>SUEnableAutomaticChecks</key>
    @SPARKLE_AUTOMATIC_CHECKS@
    <key>SUScheduledCheckInterval</key>
    <integer>21600</integer>
    <key>SURequireSignedFeed</key>
    <true/>
    <key>SUVerifyUpdateBeforeExtraction</key>
    <true/>
</dict>
</plist>
