// Released local land patterns, component-side view (+y down).
// Electrical pin definitions checked against TI SLUS810N and ST DS12239.
// https://www.ti.com/lit/ds/symlink/bq24073.pdf
// https://www.st.com/resource/en/datasheet/mp34dt05-a.pdf
pub device BQ24073RGTR {
    pins {
        required TS: 1 [input]
        required BAT: 2, 3 [bidirectional]
        required CE: 4 [input]
        required EN2: 5 [input]
        required EN1: 6 [input]
        optional PGOOD: 7 [bidirectional] // open-drain output
        required VSS: 8 [power_in]
        required CHG: 9 [bidirectional] // open-drain output
        required OUT: 10, 11 [power_out]
        required ILIM: 12 [input]
        required IN: 13 [power_in]
        optional TMR: 14 [input]
        required TD: 15 [input]
        required ISET: 16 [bidirectional]
        required EPAD: 17 [power_in]
    }
}
impl IC for BQ24073RGTR {}
pub part CHARGER_BQ24073RGTR: BQ24073RGTR {
    primary { mfr: "Texas Instruments", mpn: "BQ24073RGTR", footprint: FP_TI_RGT_VQFN16_3x3_EP1p68 }
}

pub device MP34DT05TR_A {
    pins {
        required VDD: 1 [power_in]
        required SELECT: 2 [input]
        required CLK: 3 [input]
        required DATA: 4 [output]
        required GND: 5 [power_in]
    }
}
impl mic::Microphone for MP34DT05TR_A {}
pub part MIC_ST_MP34DT05TR_A: MP34DT05TR_A {
    primary { mfr: "STMicroelectronics", mpn: "MP34DT05TR-A", footprint: FP_ST_MP34DT05_HCLGA_3x4 }
}

pub device PicoBlade3Pin {
    pins {
        required P1: 1 [passive]
        required P2: 2 [passive]
        required P3: 3 [passive]
        optional MP_LEFT: ML [passive]
        optional MP_RIGHT: MR [passive]
    }
}
impl Connector for PicoBlade3Pin {}
pub part CONN_PICOBLADE_53261_0371: PicoBlade3Pin {
    primary { mfr: "Molex", mpn: "53261-0371", footprint: FP_MOLEX_53261_0371 }
}

